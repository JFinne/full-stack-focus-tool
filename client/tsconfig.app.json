{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],

  /* *.check.ts files are Node scripts, not browser code. They use APIs like
     `process` that don't exist in this project's DOM-only type environment, and
     nothing in the app imports them, so they're excluded from the build.

     The trade-off: they aren't type-checked here, so they could silently rot as
     the code they verify changes. `npm run check:timer` runs them through tsx,
     which surfaces broken imports and type errors at runtime — so the safeguard
     is running them, not compiling them. When we adopt a real test runner this
     exclusion goes away. */
  "exclude": ["src/**/*.check.ts"]
}
