# Copy this file to `.env` and fill in the real values.
#
# `.env` is gitignored and must stay that way — it holds your database
# password. This `.env.example` file IS committed, so that anyone setting the
# project up (including you, on another machine) can see which variables are
# needed without ever seeing the secrets.

# Postgres connection string from Neon (https://neon.tech).
#
# Use the POOLED connection string — the hostname contains "-pooler". It routes
# through a connection pooler, which is what makes this survive serverless
# deployment on Vercel. See the comments in src/lib/prisma.ts.
DATABASE_URL="postgresql://USER:PASSWORD@ep-something-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Optional locally, required once deployed.
#
# Schema migrations must bypass the connection pooler — pooled connections in
# transaction mode can't reliably hold the locks that CREATE TABLE needs. So
# this is the same database via its DIRECT (non-pooler) hostname.
#
# If unset, prisma.config.ts falls back to DATABASE_URL, which is fine as long
# as DATABASE_URL is itself a direct connection.
# DIRECT_URL="postgresql://USER:PASSWORD@ep-something.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Port the API server listens on locally. The Vite dev proxy in
# client/vite.config.ts is pointed at 3000, so change both if you change this.
PORT=3000
