// This is your Prisma schema file. It is the single source of truth for what
// your database looks like. You describe your tables here, and Prisma does two
// things with that description:
//
//   1. Generates SQL migrations — versioned files that create or alter the real
//      tables in Postgres.
//   2. Generates a typed client — so `prisma.user.findUnique(...)` autocompletes
//      your actual columns and errors on a typo.
//
// Docs: https://pris.ly/d/prisma-schema

generator client {
  // "prisma-client" is the modern generator (Prisma 7). Older tutorials will
  // say "prisma-client-js" — that's the legacy one.
  provider = "prisma-client"

  // The generated client is written into our source folder rather than hidden
  // inside node_modules. It's gitignored, so it never gets committed — after
  // cloning this repo you run `npx prisma generate` to recreate it.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Note there is no `url` here. In Prisma 7 the connection string lives in
  // prisma.config.ts, which reads it from the DATABASE_URL environment
  // variable. Keeping it out of this file means the schema is safe to commit
  // while the password never is.
}

/// A person with an account on the focus tool.
///
/// Postgres tables are conventionally lowercase and plural, while Prisma models
/// are singular and capitalised. `@@map` at the bottom bridges the two: you
/// write `prisma.user` in code, the real table is called `users`.
model User {
  /// Primary key — the unique identifier for a row.
  ///
  /// We use a random string (cuid) rather than an auto-incrementing number, and
  /// the reason is specific to this app. Sequential IDs leak information: if
  /// your account is /users/4, anyone can guess that /users/5 exists, and can
  /// tell how many users the app has. Since we're going to build shareable
  /// links for boards and notes, guessable IDs would eventually mean guessable
  /// documents. Random IDs make that whole category of problem disappear.
  ///
  /// cuid() also generates the ID in the application rather than the database,
  /// which means we know a record's ID before we save it — handy later.
  id String @id @default(cuid())

  /// Login identifier. `@unique` tells Postgres to enforce that no two rows
  /// share an email — enforced by the *database*, not just our code. That
  /// distinction matters: two signup requests arriving at the same instant
  /// could both pass an "is this email taken?" check in our code, but the
  /// database will still refuse the second one.
  ///
  /// Postgres string comparison is case-sensitive, so "Sam@x.com" and
  /// "sam@x.com" would count as different accounts. We'll normalise emails to
  /// lowercase before saving them, in the auth code in the next chunk.
  email String @unique

  /// The user's password after hashing — never the password itself.
  ///
  /// Hashing is one-way: we can check whether a submitted password matches, but
  /// we can never recover the original. So if this database is ever stolen, the
  /// passwords in it are not usable. The actual hashing happens in chunk 3;
  /// the column exists now so we don't need a second migration to add it.
  passwordHash String

  /// The name shown in the UI and to people they share boards with.
  displayName String

  /// Bookkeeping timestamps.
  /// `@default(now())` is set once when the row is created.
  /// `@updatedAt` is rewritten by Prisma on every update.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Every login session this user currently has open.
  ///
  /// This line creates no column. It's the Prisma-side view of the relation
  /// that Session declares below, and it's what lets you write
  /// `prisma.user.findUnique({ include: { sessions: true } })`.
  sessions Session[]

  /// This user's settings. Optional (`?`) because the row is created lazily —
  /// see the UserPreferences comment below.
  preferences UserPreferences?

  @@map("users")
}

/// Everything the user can configure about how the app behaves.
///
/// This is a separate table rather than columns on `users` because the two hold
/// different kinds of thing. `users` answers "who is this?" and is nearly
/// immutable. Preferences answer "how do they like it?" and will grow steadily
/// — Pomodoro durations, Focus Mode rules, which add-ons are enabled. Keeping
/// them apart means the users table stays small and stable while this one
/// changes freely.
///
/// It is a *one-to-one* relation: each user has at most one preferences row.
/// The `@unique` on userId is what enforces that — without it, the same user
/// could have many preference rows and nothing would say which one counts.
model UserPreferences {
  id String @id @default(cuid())

  /// `@unique` is what makes this one-to-one rather than one-to-many.
  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The DaisyUI theme name, or "system" to follow the OS setting.
  ///
  /// Stored as a plain string rather than a database enum. An enum would let
  /// Postgres reject invalid values, which sounds better — but adding a theme
  /// would then require a migration, and theme names are a presentation detail
  /// that shouldn't be baked into the database's type system. We validate
  /// against an allowlist in the API instead, which is where the list of
  /// available themes actually lives.
  theme String @default("system")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_preferences")
}

/// One active login. A row here means "this browser is signed in as this user."
///
/// Sessions live in the database rather than in the server's memory, and that
/// is a requirement rather than a preference for us: on Vercel the API runs as
/// a serverless function that sleeps between requests and forgets everything in
/// memory. Anything that must outlive a single request has to be written down.
///
/// The upside is that logging out actually works everywhere, and you could
/// build a "sign out all my other devices" feature by deleting rows.
model Session {
  /// The SHA-256 hash of the session token — NOT the token itself.
  ///
  /// The flow: we generate a long random token, send it to the browser in a
  /// cookie, and store only its hash here. When a request arrives we hash the
  /// cookie value and look for a matching row.
  ///
  /// Why bother, when the token is random rather than secret-like a password?
  /// Because it limits the blast radius of a database leak. A stolen `users`
  /// table gives an attacker unusable password hashes; a stolen `sessions`
  /// table full of raw tokens would let them log in as anyone, instantly. Hashed
  /// tokens are useless in the same way hashed passwords are.
  ///
  /// Note we use a *fast* hash (SHA-256) here, where passwords need a
  /// deliberately *slow* one. That's not an inconsistency. Slow hashing exists
  /// to make guessing infeasible, and matters only because human passwords are
  /// guessable. A 256-bit random token cannot be guessed at any speed, so the
  /// only job here is to be irreversible — and fast is a feature, since this
  /// runs on every single request.
  id String @id

  /// Which user this session belongs to.
  userId String

  /// The relation itself.
  ///
  /// `onDelete: Cascade` tells Postgres that deleting a user must also delete
  /// their sessions. Without it the database would refuse to delete a user who
  /// still has sessions — a foreign key pointing at a row that doesn't exist is
  /// exactly what foreign keys are there to prevent. Cascade says "clean up the
  /// dependents automatically," which is right here: a session belonging to a
  /// deleted account is meaningless.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// When this session stops being valid.
  ///
  /// Checked on every request. Expiry is what bounds the damage if a session
  /// cookie is ever stolen — without it, one leaked token would work forever.
  expiresAt DateTime

  createdAt DateTime @default(now())

  /// An index on userId.
  ///
  /// Indexes make lookups by a column fast. We'll query "all sessions for this
  /// user" when logging out everywhere, and without an index Postgres would
  /// scan the entire table each time. Primary keys and @unique columns get
  /// indexes automatically; other columns you search by need to be declared.
  @@index([userId])
  @@map("sessions")
}
