{
  "name": "full-stack-focus-tool",
  "private": true,
  "version": "0.0.0",
  "description": "A full-stack productivity and focus tool for managing school workloads.",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client && npm run build --workspace server",
    "typecheck": "npm run typecheck --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
