# Dependencies (reinstalled from package.json, never committed)
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Environment variables — these hold secrets like database passwords and API
# keys. Committing them would publish those secrets to GitHub forever, so this
# line matters more than any other in this file.
.env
.env.*
!.env.example

# Prisma auto-installs ~150 files of AI-agent reference docs on `prisma init`.
# They're useful locally but they're vendor documentation, not our code, and
# they'd bury real changes in every diff. Regenerate with `npx prisma init`.
server/.agents/
server/.claude/
server/skills-lock.json

# Editor / OS noise
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Vercel
.vercel
